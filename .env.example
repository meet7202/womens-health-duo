# Public site URL (no trailing slash). Defaults to https://womenshealthduo.com in code if unset.
VITE_SITE_URL=https://womenshealthduo.com

# Optional — Cloudflare Worker deploy (workers/markdown-for-agents); set account_id in wrangler.toml instead.
# CLOUDFLARE_API_TOKEN=

# IndexNow (Bing + partners) — key file is generated at build into dist/{key}.txt
INDEXNOW_KEY=your-indexnow-key-here

# Google Indexing API — OPTIONAL and fail-closed. Ordinary WHD sitemap URLs must NOT be
# submitted (API is limited to JobPosting / livestream BroadcastEvent). Prefer Search Console.
# Only set credentials if you pass an explicit eligible --urls-file= to submit-google-indexing.mjs.
# Unused credentials may be revoked in GCP / Search Console by the owner.
# GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=./google-indexing-service-account.json
